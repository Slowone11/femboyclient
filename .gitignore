# mod/.gitignore and server/.gitignore cover each half (secrets, builds, databases, the venv).

# Per-machine Claude Code settings.
.claude/settings.local.json

# Release jars downloaded to hand out by hand.
dist/

# Safety net: no database or log is ever committed, wherever it is.
*.db
*.db-wal
*.db-shm
*.log

# Per-machine agent voice rules dropped by caveman-init (CLAUDE.md has its own copy).
AGENTS.md
.cursor/
.clinerules/
.windsurf/
.opencode/
.github/copilot-instructions.md
